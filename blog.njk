---
layout: base.njk
title: Writing — Sepehr Saeedpour
description: "Writing by Sepehr Saeedpour — notes on computational neuroscience, learning, and ideas in progress."
navPage: writing
footerClass: blog-footer
permalink: /blog.html
---
<div class="blog-layout-wrapper">
  <div class="blog-layout">

    <!-- Left panel -->
    <aside class="blog-panel" id="blog-panel">
      <p class="panel-heading">Writing</p>
      <ul class="panel-list" id="panel-list">
        <!-- Populated by JS -->
      </ul>
    </aside>

    <!-- Right content -->
    <article class="blog-content" id="blog-content">

      <!-- Post header: populated by JS -->
      <div class="post-header" id="post-header" style="display:none;">
        <h1 class="post-title-display" id="post-title"></h1>
        <p class="post-meta-display" id="post-meta"></p>
      </div>

      <!-- Post body: rendered markdown -->
      <div class="post-body" id="post-body">
        <p class="blog-empty">Select a post from the panel.</p>
      </div>

      <a href="/" class="back-link">&larr; back</a>

    </article>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/marked@9/marked.min.js"></script>
<script>
  marked.setOptions({ breaks: false, gfm: true });

  let allPosts = [];

  function buildPanel(posts) {
    const list = document.getElementById('panel-list');
    if (!posts || posts.length === 0) {
      list.innerHTML = '<li style="font-style:italic;color:var(--color-muted);font-size:var(--size-meta);">No posts yet.</li>';
      return;
    }
    list.innerHTML = posts.map(post => `
      <li>
        <a
          class="panel-item"
          data-slug="${post.slug}"
          href="blog.html#${post.slug}"
          onclick="loadPost('${post.slug}'); return false;"
        >
          <span class="panel-item-date">${post.date}</span>
          <span class="panel-item-title">${post.title}</span>
        </a>
      </li>
    `).join('');
  }

  async function loadPost(slug) {
    document.querySelectorAll('.panel-item').forEach(el => {
      el.classList.toggle('active', el.dataset.slug === slug);
    });

    history.replaceState(null, '', `#${slug}`);

    const post = allPosts.find(p => p.slug === slug);

    const header = document.getElementById('post-header');
    header.style.display = 'block';
    document.getElementById('post-title').textContent = post ? post.title : slug;
    document.getElementById('post-meta').textContent  = post ? post.date : '';

    const body = document.getElementById('post-body');
    body.innerHTML = '<p style="color:var(--color-muted);font-style:italic;">Loading&hellip;</p>';

    try {
      const res = await fetch(`content/blog/${slug}.md`);
      if (!res.ok) throw new Error(`${res.status}`);
      const text = await res.text();
      body.innerHTML = marked.parse(text);
    } catch (err) {
      body.innerHTML = '<p style="color:var(--color-muted);font-style:italic;">Post not found.</p>';
    }

    if (window.innerWidth <= 640) {
      document.getElementById('blog-content').scrollIntoView({ behavior: 'smooth' });
    }
  }

  fetch('content/blog/posts.json')
    .then(r => r.json())
    .then(posts => {
      allPosts = posts;
      buildPanel(posts);

      const hash = location.hash.slice(1);
      const initial = posts.find(p => p.slug === hash) || posts[0];
      if (initial) {
        loadPost(initial.slug);
      }
    })
    .catch(() => {
      document.getElementById('panel-list').innerHTML =
        '<li style="font-style:italic;color:var(--color-muted);font-size:var(--size-meta);">No posts yet.</li>';
    });
</script>
