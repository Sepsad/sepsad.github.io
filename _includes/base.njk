<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://sepsad.github.io{{ page.url }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:image" content="https://sepsad.github.io/assets/profile.jpg">
  <meta name="twitter:card" content="summary">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=Courier+Prime&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/style.css">
</head>
<body>

  {% if not noHeader %}
  <header>
    <nav class="nav-inner">
      <a href="/" class="site-name">sepsad</a>
      <ul class="nav-links">
        <li><a href="/about.html"{% if navPage == "about" %} class="nav-active"{% endif %}>about</a></li>
        <li><a href="/research.html"{% if navPage == "research" %} class="nav-active"{% endif %}>research</a></li>
        <li><a href="/publications.html"{% if navPage == "publications" %} class="nav-active"{% endif %}>publications</a></li>
        <li><a href="/blog.html"{% if navPage == "writing" %} class="nav-active"{% endif %}>writing</a></li>
        <li><a href="/contact.html"{% if navPage == "contact" %} class="nav-active"{% endif %}>contact</a></li>
        <li><a href="/assets/Sepsad_cv.pdf" target="_blank" rel="noopener">cv</a></li>
      </ul>
    </nav>
  </header>
  {% endif %}

  {{ content | safe }}

  <footer{% if footerClass %} class="{{ footerClass }}"{% endif %}>
    <p class="footer-note">&mdash; Paris, 2025</p>
  </footer>

</body>
</html>
